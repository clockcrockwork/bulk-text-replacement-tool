# GitHub 連携（docs/github-app-setup.md）。ローカルで試すときは .env.local にコピーする。
# VITE_ で始まるものはビルドに埋め込まれる公開値。
VITE_GITHUB_APP_CLIENT_ID=
VITE_GITHUB_APP_SLUG=

# 以下は Vercel Function（api/github/token.js）だけが読む。ブラウザには配らない。
GITHUB_APP_CLIENT_SECRET=
GITHUB_OAUTH_ALLOWED_ORIGINS=http://localhost:3000
GITHUB_OAUTH_REDIRECT_URIS=http://localhost:3000/
